{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "startCommand": "gunicorn app:app --bind 0.0.0.0:8080 --timeout 300 --workers 2",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 100
  }
}
